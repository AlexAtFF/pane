{
  "manifest_version": 3,
  "name": "Open in Pane",
  "version": "1.1.0",
  "description": "Right-click a YouTube or Twitch video (or its link) and open it in Pane.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open this video in Pane" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.twitch.tv/*"],
      "js": ["links.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
